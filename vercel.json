{
    "outputDirectory": "public",
    "rewrites": [
        {
            "source": "/catalogo",
            "destination": "/catalogo.html"
        },
        {
            "source": "/catalogo/",
            "destination": "/catalogo.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                }
            ]
        }
    ]
}
